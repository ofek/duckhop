root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json,json5}]
indent_size = 2

[*.{cpp,h,hpp}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.md]
indent_size = 4
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab
indent_size = tab

[*.cmake]
indent_size = 4

[CMakeLists.txt]
indent_size = 4
